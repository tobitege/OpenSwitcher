<Window
    x:Class="OpenSwitcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:OpenSwitcher.Core"
    xmlns:local="using:OpenSwitcher">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20" Spacing="10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Switch Mcp and Model for OpenCode (unofficial)" />
                        <TextBlock Opacity="0.72" Text="Synchronize local model catalogs with OpenCode" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Padding="20,10"
                        Click="RefreshButton_Click"
                        Content="Refresh"
                        VerticalAlignment="Center" />
                </Grid>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Message="Querying local model servers."
                    Severity="Informational" />

                <ItemsControl x:Name="LocalProvidersList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LocalProviderSection">
                            <Border
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                            <TextBlock
                                                FontFamily="Segoe UI Symbol"
                                                FontSize="18"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Text="⚠"
                                                ToolTipService.ToolTip="{x:Bind Warning, Mode=OneWay}"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HasWarning, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Opacity="0.65"
                                                Text="{x:Bind CountText, Mode=OneWay}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Padding="6"
                                                AutomationProperties.Name="{x:Bind RefreshToolTip}"
                                                Click="LocalProviderRefreshButton_Click"
                                                ToolTipService.ToolTip="{x:Bind RefreshToolTip}"
                                                Visibility="{x:Bind IsUnavailable, Mode=OneWay}">
                                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <ListBox
                                        Height="132"
                                        HorizontalContentAlignment="Stretch"
                                        ItemsSource="{x:Bind Models}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                        SelectionMode="Single"
                                        Visibility="{x:Bind IsAvailable, Mode=OneWay}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Height" Value="26" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="MinHeight" Value="26" />
                                                <Setter Property="Padding" Value="8,0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:SelectableLocalModel">
                                                <CheckBox
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="{x:Bind DisplayText}">
                                                    <Border
                                                        Padding="8,0"
                                                        Background="{Binding IsLoaded, Converter={StaticResource LoadedModelBackgroundConverter}}"
                                                        CornerRadius="4">
                                                        <Grid ColumnSpacing="10" HorizontalAlignment="Left">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind LoadedLabel}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{x:Bind DisplayText}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind CapabilityLabel}"
                                                                TextWrapping="NoWrap" />
                                                        </Grid>
                                                    </Border>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button
                                        Padding="16,7"
                                        Click="ApplyLocalProviderButton_Click"
                                        Content="{x:Bind ApplyText}"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{x:Bind IsApplyEnabled, Mode=OneWay}"
                                        Visibility="{x:Bind IsAvailable, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="OpenCode providers" />
                                <TextBlock
                                    x:Name="ProvidersWarningIcon"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="18"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Text="⚠"
                                    ToolTipService.ToolTip="The OpenCode providers could not be loaded."
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    x:Name="ProvidersCountText"
                                    Opacity="0.65"
                                    Text="loading …"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="ProvidersRefreshButton"
                                    Padding="6"
                                    Click="ProvidersRefreshButton_Click"
                                    ToolTipService.ToolTip="Refresh OpenCode providers"
                                    Visibility="Collapsed">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid
                            x:Name="ProvidersHeader"
                            Padding="12,0"
                            ColumnSpacing="10"
                            Opacity="0.65">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="Provider" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Name" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Key" />
                        </Grid>
                        <ListView
                            x:Name="ProvidersList"
                            MaxHeight="132"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Height" Value="26" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="26" />
                                    <Setter Property="Padding" Value="12,0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:ConfiguredProvider">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Id}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind KeyKind}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="MCP servers" />
                                <TextBlock
                                    x:Name="McpWarningIcon"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="18"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Text="⚠"
                                    ToolTipService.ToolTip="The MCP servers could not be loaded."
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    x:Name="McpCountText"
                                    Opacity="0.65"
                                    Text="loading …"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="McpRefreshButton"
                                    Padding="6"
                                    Click="McpRefreshButton_Click"
                                    ToolTipService.ToolTip="Refresh MCP servers"
                                    Visibility="Collapsed">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ListView
                            x:Name="McpServersList"
                            Height="158"
                            SelectionChanged="McpServersList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Height" Value="26" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="26" />
                                    <Setter Property="Padding" Value="12,0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:McpServerItem">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Fill="{x:Bind StatusBrush}"
                                            ToolTipService.ToolTip="{x:Bind StatusDescription}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind TypeLabel}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            FontFamily="Consolas"
                                            Text="{x:Bind Target}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Target}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Opacity="0.65"
                                            Text="{x:Bind EnabledLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="McpButtonsPanel" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="AddMcpServerButton"
                                Padding="16,7"
                                Click="AddMcpServerButton_Click"
                                Content="Add …" />
                            <Button
                                x:Name="EditMcpServerButton"
                                Padding="16,7"
                                Click="EditMcpServerButton_Click"
                                Content="Edit …"
                                IsEnabled="False" />
                            <Button
                                x:Name="DeleteMcpServerButton"
                                Padding="16,7"
                                Click="DeleteMcpServerButton_Click"
                                Content="Delete …"
                                IsEnabled="False" />
                            <Button
                                x:Name="ImportMcpServersButton"
                                Padding="16,7"
                                Click="ImportMcpServersButton_Click"
                                Content="Import from Codex, Claude or Cursor …" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="ConfigPathText"
                    FontFamily="Consolas"
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Padding="20,6,20,4" Spacing="2">
            <Rectangle Height="1" Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            <HyperlinkButton
                Padding="4"
                HorizontalAlignment="Center"
                NavigateUri="https://github.com/tobitege/OpenSwitcher"
                ToolTipService.ToolTip="https://github.com/tobitege/OpenSwitcher">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon
                        VerticalAlignment="Center"
                        Data="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
                    <TextBlock VerticalAlignment="Center" Text="tobitege/OpenSwitcher" />
                </StackPanel>
            </HyperlinkButton>
        </StackPanel>
    </Grid>
</Window>
