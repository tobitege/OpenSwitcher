<ContentDialog
    x:Class="OpenSwitcher.McpImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSwitcher"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="McpImportDialog_PrimaryButtonClick"
    PrimaryButtonText="Import"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Import MCP servers">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="920" Spacing="12">
        <InfoBar
            x:Name="StatusInfoBar"
            IsClosable="False"
            IsOpen="False" />
        <ComboBox
            x:Name="SourceComboBox"
            Width="240"
            Header="Source"
            SelectionChanged="SourceComboBox_SelectionChanged">
            <x:String>Codex</x:String>
            <x:String>Claude Code</x:String>
            <x:String>Cursor</x:String>
        </ComboBox>
        <TextBlock
            x:Name="SourcePathText"
            FontFamily="Consolas"
            FontSize="12"
            Opacity="0.7"
            TextWrapping="Wrap" />
        <ListView
            x:Name="ServersList"
            Height="290"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="8,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SelectableMcpImport">
                    <CheckBox
                        Checked="ServerCheckBox_Changed"
                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                        Unchecked="ServerCheckBox_Changed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Opacity="0.65"
                                Text="{x:Bind Origin}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Origin}" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind TypeLabel}" />
                            <TextBlock
                                Grid.Column="3"
                                FontFamily="Consolas"
                                Text="{x:Bind Target}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Target}" />
                            <TextBlock
                                Grid.Column="4"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="{x:Bind ConflictLabel}" />
                        </Grid>
                    </CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
