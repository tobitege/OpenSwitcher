<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OpenSwitcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\OpenSwitcher.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <NeutralLanguage>en-US</NeutralLanguage>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSwitcher.Core\OpenSwitcher.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\OpenSwitcher.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="KeepOnlyEnglishRuntimeResources" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <_NonEnglishRuntimeResources
        Include="@(None)"
        Condition="'%(None.Extension)' == '.mui' and '%(None.RecursiveDir)' != 'en-us\'" />
      <_NonEnglishRuntimeResourceDirectories
        Include="@(_NonEnglishRuntimeResources->'$(OutDir)%(RecursiveDir)')" />
      <None
        Remove="@(_NonEnglishRuntimeResources)" />
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.mui' and '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' != 'en-us\'" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveNonEnglishRuntimeResourceDirectories" AfterTargets="Build">
    <RemoveDir Directories="@(_NonEnglishRuntimeResourceDirectories)" />
  </Target>
</Project>
